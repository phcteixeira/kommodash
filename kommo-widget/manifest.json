{
  "widget": {
    "name": "widget.name",
    "description": "widget.description",
    "short_description": "widget.short_description",
    "version": "1.1.0",
    "interface_version": 2,
    "init_once": true,
    "locale": ["pt", "en"],
    "installation": true,
    "support": {
      "link": "https://kommodash.vercel.app",
      "email": "pzzamarketing@gmail.com"
    }
  },
  "locations": ["salesbot_designer", "lcard-1"],
  "settings": {
    "webhook_url": {
      "name": "settings.webhook_url",
      "type": "text",
      "required": false,
      "default_value": "https://kommodash.vercel.app/api/agent/webhook"
    },
    "contracts_products_url": {
      "name": "settings.contracts_products_url",
      "type": "text",
      "required": false,
      "default_value": "https://kommodash.vercel.app/api/agent/contracts/products"
    },
    "contracts_register_url": {
      "name": "settings.contracts_register_url",
      "type": "text",
      "required": false,
      "default_value": "https://kommodash.vercel.app/api/agent/contracts/register"
    },
    "contracts_secret": {
      "name": "settings.contracts_secret",
      "type": "text",
      "required": false,
      "default_value": ""
    }
  },
  "salesbot_designer": {
    "logo": "/widgets/botclaude/images/logo.png",
    "ai_reply": {
      "name": "salesbot.handler_name",
      "settings": {
        "webhook_url": {
          "name": "salesbot.webhook_url",
          "type": "text",
          "default_value": "https://kommodash.vercel.app/api/agent/webhook",
          "manual": true
        }
      }
    },
    "business_hours_gate": {
      "name": "salesbot.business_hours_gate_name",
      "settings": {
        "webhook_url": {
          "name": "salesbot.webhook_url",
          "type": "text",
          "default_value": "https://kommodash.vercel.app/api/agent/business-hours-gate",
          "manual": true
        }
      }
    }
  }
}
