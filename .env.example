# Subdomínio da sua conta Kommo (ex.: se sua URL é https://minhaempresa.kommo.com, use "minhaempresa")
KOMMO_SUBDOMAIN=

# Token de longa duração (Long-lived token)
# Como gerar: no Kommo, vá em Ajustes > Integrações > Criar integração > aba "Chaves e escopos"
# e gere um "Token de longa duração" para a própria conta.
KOMMO_ACCESS_TOKEN=
