# Subdomínio da sua conta Kommo (ex.: se sua URL é https://minhaempresa.kommo.com, use "minhaempresa")
KOMMO_SUBDOMAIN=

# Token de longa duração (Long-lived token)
# Como gerar: no Kommo, vá em Ajustes > Integrações > Criar integração > aba "Chaves e escopos"
# e gere um "Token de longa duração" para a própria conta.
KOMMO_ACCESS_TOKEN=

# --- Agente de IA no WhatsApp (Salesbot widget_request) ---
# Integração privada separada, criada só para o agente. client_id/client_secret
# aparecem na tela da integração (o secret costuma ser mostrado uma única vez).
# Usados para validar a assinatura do JWT que a Kommo envia a cada mensagem.
KOMMO_INTEGRATION_CLIENT_ID=
KOMMO_INTEGRATION_CLIENT_SECRET=
